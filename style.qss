QLabel#topic {
    font-size: 24px;
    font-weight: bold;
    color: #0078D4;
    }

QLineEdit#input {
    min-height: 48px;
    font-size: 14px;
    }
QLabel#fieldLabel {
    min-height: 48px;     
    font-size: 14px;
    }
QPushButton#smallBtn {
    min-height: 32px;
    max-height: 32px;
    font-size: 18px;
    }
QPushButton#primaryBtn {
    min-height: 32px;
    max-height: 32px;
    font-size: 16px;
    background-color: #0078D4;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 4px 16px;
}
QPushButton#primaryBtn:hover {
    background-color: #106EBE;
}
QPushButton#primaryBtn:pressed {
    background-color: #005A9E;
}

QListWidget {
    font-size: 24px;
    min-height: 200px;
    }
QListWidget::item {
    min-height: 50px;
    padding: 6px 10px;
    }
QListWidget::item:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
    }
QPushButton#deleteBtn {
    min-height: 36px;
    font-size: 16px;
    background-color: #B0074D;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 4px 16px;
}
QPushButton#deleteBtn:hover {
    background-color: #8E053E;
}
QPushButton#deleteBtn:pressed {
    background-color: #6D032F;
}
QLabel#counterLabel {
    font-size: 20px;
    padding: 6px 12px;
        }