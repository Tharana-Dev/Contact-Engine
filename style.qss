/* ============================================================ */
/*  Global                                                       */
/* ============================================================ */

/* ============================================================ */
/*  Data Form                                                   */
/* ============================================================ */
QLabel#topic {
    font-size: 24px;
    font-weight: bold;
    color: #0078D4;
        }

QLabel#fieldLabel {
    min-height: 48px;     
    font-size: 14px;
        }
QLineEdit#input {
    min-height: 48px;
    font-size: 14px;
        }
QPushButton#primaryBtn {
    min-height: 32px;
    max-height: 32px;
    font-size: 16px;
    background-color: #0078D4;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 4px 16px;
        }

QPushButton#primaryBtn:hover {
    background-color: #106EBE;
        }

QPushButton#primaryBtn:pressed {
    background-color: #005A9E;
        }
QPushButton#smallBtn {
    min-height: 32px;
    max-height: 32px;
    font-size: 18px;
        }

/* ============================================================ */
/*  List Panel                                                   */
/* ============================================================ */

QPushButton#deleteBtn {
    min-height: 36px;
    font-size: 16px;
    background-color: #B0074D;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 4px 16px;
        }
QPushButton#deleteBtn:hover {
    background-color: #8E053E;
        }
QPushButton#deleteBtn:pressed {
    background-color: #6D032F;
        }

QTableView {
    background-color: #2b2b2b;
    alternate-background-color: #2f2f2f;
    border: 1px solid #3a3a3a;
    selection-background-color: #1e4a7a;
    selection-color: #ffffff;
        }

QTableView::item {
    padding: 8px 12px;
    min-height: 30px;
    border: none;
    outline: 0;
        }  

QTableView::item:selected {
    background-color: #1e4a7a;
    color: #ffffff;
        }

QHeaderView::section {
    background-color: #333333;
    color: #e0e0e0;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #4a4a4a;
    font-weight: bold;
        }

/* ============================================================ */
/*  Status Bar                                                   */
/* ============================================================ */
QLabel#counterLabel {
    font-size: 20px;
    padding: 6px 12px;
    }